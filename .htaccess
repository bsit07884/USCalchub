<IfModule mod_rewrite.c>
RewriteEngine On

# 1. If non-file, missing trailing slash, and not a file extension -> redirect to canonical non-www WITH slash
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
RewriteRule ^(.*)$ https://uscalchub.com/$1/ [L,R=301]

# 2. If it already has a slash (or is a file), but has 'www.' -> redirect to canonical non-www
RewriteCond %{HTTP_HOST} ^www\.uscalchub\.com [NC]
RewriteRule ^(.*)$ https://uscalchub.com/$1 [L,R=301]

</IfModule>
